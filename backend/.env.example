# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

ENVIRONMENT=development

# Default (no setup required): local SQLite file.
# DATABASE_URL=sqlite:///./campusar.db

# Recommended for real development, matches docker-compose.yml:
DATABASE_URL=postgresql+psycopg2://campusar:campusar@localhost:5432/campusar

CAMPUS_ID=tongmyong-main
CAMPUS_DATA_VERSION=1.0.0

# Comma-separated list is fine too if you adapt config.py; default allows all
# origins for local development. Lock this down before deploying publicly.
CORS_ORIGINS=["*"]
